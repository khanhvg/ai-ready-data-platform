{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/openapi/learning-platform-openapi-profile-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "openapi",
    "info",
    "paths",
    "components"
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$ref"
      ],
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^#/components/"
        }
      }
    },
    "schema": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 12
    },
    "parameter": {
      "oneOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "in",
            "required",
            "schema"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "in": {
              "enum": [
                "path",
                "header",
                "query"
              ]
            },
            "required": {
              "type": "boolean"
            },
            "schema": {
              "$ref": "#/$defs/schema"
            }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "parameters",
        "security",
        "responses"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]{2,63}$"
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "security": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bearerAuth": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        "requestBody": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "content"
          ],
          "properties": {
            "required": {
              "const": true
            },
            "content": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "application/json"
              ],
              "properties": {
                "application/json": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema"
                  ],
                  "properties": {
                    "schema": {
                      "$ref": "#/$defs/reference"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "type": "object",
          "minProperties": 4,
          "maxProperties": 4,
          "patternProperties": {
            "^[1-5][0-9][0-9]$": {
              "$ref": "#/$defs/reference"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "pathItem": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "get": {
          "$ref": "#/$defs/operation"
        },
        "post": {
          "$ref": "#/$defs/operation"
        }
      }
    }
  },
  "properties": {
    "openapi": {
      "const": "3.2.0"
    },
    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "version"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "const": "learning-platform-v1"
        }
      }
    },
    "paths": {
      "type": "object",
      "minProperties": 16,
      "maxProperties": 16,
      "patternProperties": {
        "^/": {
          "$ref": "#/$defs/pathItem"
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "securitySchemes",
        "parameters",
        "schemas",
        "responses"
      ],
      "properties": {
        "securitySchemes": {
          "type": "object",
          "minProperties": 1
        },
        "parameters": {
          "type": "object",
          "minProperties": 1
        },
        "schemas": {
          "type": "object",
          "minProperties": 2
        },
        "responses": {
          "type": "object",
          "minProperties": 2
        }
      }
    }
  }
}
