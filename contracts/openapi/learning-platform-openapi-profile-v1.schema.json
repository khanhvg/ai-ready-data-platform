{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/openapi/learning-platform-profile-v1.schema.json",
  "type": "object",
  "required": [
    "openapi",
    "info",
    "paths",
    "components"
  ],
  "properties": {
    "openapi": {
      "const": "3.2.0"
    },
    "info": {
      "type": "object",
      "required": [
        "title",
        "version"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "unevaluatedProperties": false
    },
    "paths": {
      "type": "object",
      "patternProperties": {
        "^/": {
          "type": "object",
          "patternProperties": {
            "^(get|post)$": {
              "type": "object"
            }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "components": {
      "type": "object"
    }
  },
  "unevaluatedProperties": false
}
