{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/openapi/learning-platform-problem-details-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title",
    "status",
    "code",
    "detail",
    "correlationId",
    "retryable",
    "remediationId",
    "contractVersion"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri-reference",
      "maxLength": 256
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*(?:/Users/|/private/|/tmp/|token|secret|SELECT |INSERT |UPDATE |DELETE )).*$"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "retryable": {
      "type": "boolean"
    },
    "remediationId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "contractVersion": {
      "const": "learning-platform-v1"
    }
  }
}
