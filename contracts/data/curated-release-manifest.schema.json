{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-ready-data-platform:curated-release-manifest-v1",
  "x-contractId": "curated-release-v1",
  "x-publicationBehavior": "not-implemented-by-i5-01",
  "x-rollbackModel": "pointer-to-previously-validated-complete-manifest",
  "x-assetIds": [
    "mart_daily_revenue", "mart_top_products", "mart_customer_cohorts", "mart_fulfillment_performance",
    "mart_returns_analysis", "mart_promotion_effectiveness", "mart_channel_geography", "mart_inventory_health",
    "mart_web_funnel_conversion", "mart_supplier_purchasing", "mart_data_quality"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "assetId": {"enum": [
      "mart_daily_revenue", "mart_top_products", "mart_customer_cohorts", "mart_fulfillment_performance",
      "mart_returns_analysis", "mart_promotion_effectiveness", "mart_channel_geography", "mart_inventory_health",
      "mart_web_funnel_conversion", "mart_supplier_purchasing", "mart_data_quality"
    ]},
    "asset": {
      "type": "object",
      "required": ["assetId", "releaseId", "dataRunId", "testedTreeSha", "lockSha256", "contractSetId", "engineSnapshotId", "logicalFqn", "physicalFqn", "schemaSha256", "contentSha256", "rowCount", "stagedLocator"],
      "properties": {
        "assetId": {"$ref": "#/$defs/assetId"}, "releaseId": {"type": "string", "minLength": 1},
        "dataRunId": {"type": "string", "minLength": 1}, "testedTreeSha": {"$ref": "#/$defs/sha1"},
        "lockSha256": {"$ref": "#/$defs/sha256"}, "contractSetId": {"type": "string", "minLength": 1},
        "engineSnapshotId": {"type": "string", "minLength": 1}, "logicalFqn": {"type": "string", "minLength": 1},
        "physicalFqn": {"type": "string", "minLength": 1}, "schemaSha256": {"$ref": "#/$defs/sha256"},
        "contentSha256": {"$ref": "#/$defs/sha256"}, "rowCount": {"type": "integer", "minimum": 0},
        "stagedLocator": {"type": "string", "pattern": "^curated/releases/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"}
      },
      "additionalProperties": false
    },
    "CuratedReleaseManifestV1": {
      "type": "object",
      "required": ["schemaVersion", "releaseId", "dataRunId", "testedTreeSha", "lockSha256", "contractSetId", "engineSnapshotId", "profile", "seed", "assets"],
      "properties": {
        "schemaVersion": {"const": "curated-release-manifest-v1"}, "releaseId": {"type": "string", "minLength": 1},
        "dataRunId": {"type": "string", "minLength": 1}, "testedTreeSha": {"$ref": "#/$defs/sha1"},
        "lockSha256": {"$ref": "#/$defs/sha256"}, "contractSetId": {"type": "string", "minLength": 1},
        "engineSnapshotId": {"type": "string", "minLength": 1}, "profile": {"const": "small"},
        "seed": {"const": 42}, "assets": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/asset"}}
      },
      "additionalProperties": false
    },
    "CuratedReleaseCurrentPointerV1": {
      "type": "object",
      "required": ["schemaVersion", "currentReleaseId", "manifestSha256"],
      "properties": {
        "schemaVersion": {"const": "curated-release-current-pointer-v1"}, "currentReleaseId": {"type": "string", "minLength": 1},
        "manifestSha256": {"$ref": "#/$defs/sha256"}, "previousReleaseId": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/CuratedReleaseManifestV1"
}
