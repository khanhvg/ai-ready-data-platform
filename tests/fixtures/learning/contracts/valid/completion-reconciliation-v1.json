{
  "schemaVersion": "completion-reconciliation-v1",
  "authorityId": "learning-progress-authority-v1",
  "authorityVersion": "v1",
  "idempotencyScope": {
    "fields": [
      "authorityId",
      "actorId",
      "operationId",
      "idempotencyKey"
    ],
    "requestDigest": "sha-256+jcs",
    "sameRequest": "return-stored-result",
    "differentRequest": "IDEMPOTENCY_KEY_REUSE"
  },
  "commitPreconditions": [
    {
      "id": "committed-operation-result",
      "required": true
    },
    {
      "id": "immutable-evidence-hash",
      "required": true
    },
    {
      "id": "expected-progress-revision",
      "required": true
    }
  ],
  "commitOrder": [
    {
      "id": "result",
      "order": 1,
      "durable": true
    },
    {
      "id": "evidence-fsync-rename",
      "order": 2,
      "durable": true
    },
    {
      "id": "progress-cas",
      "order": 3,
      "durable": true
    },
    {
      "id": "acknowledgment",
      "order": 4,
      "durable": false
    }
  ],
  "uniqueConstraints": [
    {
      "field": "runId",
      "scope": "authority-actor-operation"
    },
    {
      "field": "evidenceId",
      "scope": "authority-actor-operation"
    },
    {
      "field": "idempotencyKey",
      "scope": "authority-actor-operation"
    }
  ],
  "faultPoints": [
    {
      "id": "result",
      "disposition": "reconcile"
    },
    {
      "id": "write",
      "disposition": "reconcile"
    },
    {
      "id": "fsync",
      "disposition": "reconcile"
    },
    {
      "id": "rename",
      "disposition": "reconcile"
    },
    {
      "id": "transaction",
      "disposition": "reconcile"
    },
    {
      "id": "ack",
      "disposition": "already-attached"
    }
  ],
  "reconciliation": [
    {
      "id": "already-attached",
      "action": "return-stored-completion",
      "completes": true
    },
    {
      "id": "attachable-orphan",
      "action": "revalidate-and-cas",
      "completes": true
    },
    {
      "id": "invalid-or-conflicting-orphan",
      "action": "quarantine",
      "completes": false
    }
  ],
  "resets": {
    "casRequired": true,
    "preserveEvidence": true,
    "completionImmutable": true
  },
  "conflicts": [
    {
      "code": "IDEMPOTENCY_KEY_REUSE",
      "status": 409,
      "mutates": false
    },
    {
      "code": "PROGRESS_VERSION_CONFLICT",
      "status": 412,
      "mutates": false
    }
  ]
}
