deployment {
  environment local 'Local 16 GiB environment' {
    host browser_host 'Learner browser host' {
      browser_instance = instanceOf browser
    }
    host developer_host 'Developer workstation' {
      portal_instance = instanceOf learning.portal
      runner_instance = instanceOf learning.runner
      adapters_instance = instanceOf learning.adapters
      privateStorage workspace_evidence 'Private workspace and evidence storage' {
        progress_instance = instanceOf learning.progress
      }
      retail_instance = instanceOf retail
    }
  }
}
