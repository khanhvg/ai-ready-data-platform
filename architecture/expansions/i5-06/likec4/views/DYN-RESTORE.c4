views {
  dynamic view DYN-RESTORE {
    title 'Khôi phục object, catalog, analytics, governance và evidence'
    autoLayout TopBottom 20 20
    author -> restore 'yêu cầu khôi phục' { technology 'repository' }
    restore -> retail_iceberg 'khôi phục object và catalog' { technology 'Iceberg REST' }
    restore -> retail_duckdb 'xác minh analytics' { technology 'DuckDB' }
    restore -> adapters_instance 'khôi phục governance và evidence' { technology 'OpenMetadata' }
  }
}
