# Copy to .env and adjust as needed. Never commit the real .env.

# --- core (always local, no secrets) ---
SCALE=small
SEED=42
DUCKDB_PATH=warehouse/retail.duckdb

# --- orchestration profile (Airflow, opt-in) ---
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
# Enables the DAG's `publish` task group (parse-time gate: {"1","true","yes","on"}).
# Requires the `lake` profile up and the orchestration service force-recreated
# (a re-trigger alone won't reparse the flag) -- see docs/demo-runbook.md.
LAKE_PROFILE_ENABLED=false

# --- lake profile (MinIO + Lakekeeper, opt-in) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_local_only
LAKEKEEPER_CATALOG_NAME=retail
LAKE_S3_ENDPOINT=http://localhost:9000
LAKE_S3_BUCKET=retail-lake

# --- governance profile (OpenMetadata, opt-in) ---
OPENMETADATA_DB_USER=openmetadata_user
OPENMETADATA_DB_PASSWORD=openmetadata_local_only
# Ingestion-bot JWT for `make catalog-ingest` / governance/openmetadata/*.py.
# Never a real token here -- fetch your own from Settings -> Bots -> ingestion-bot
# in the OpenMetadata UI (or the API, see governance/openmetadata/README.md) and
# export it in your shell before running catalog-ingest. Leave blank in .env.
OPENMETADATA_JWT_TOKEN=
