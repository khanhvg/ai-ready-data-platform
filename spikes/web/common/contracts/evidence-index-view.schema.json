{
  "$id": "urn:i5-02:evidence-index-view:v1",
  "title": "EvidenceIndexView",
  "type": "object",
  "additionalProperties": false,
  "required": ["notice", "fixtureKind", "fixtureDigest", "conclusion", "records"],
  "properties": {
    "notice": { "const": "SYNTHETIC LEARN-PREVIEW — UNSCORED — CANNOT COMPLETE" },
    "fixtureKind": { "const": "synthetic-preview" },
    "fixtureDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "conclusion": { "const": "insufficient evidence" },
    "records": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "locator", "result"], "properties": { "id": { "type": "string" }, "locator": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" }, "result": { "type": "string" } } } }
  }
}
