---
import Probe from '../components/Probe.jsx';
import { loadFixture } from '../lib/fixture.mjs';
import '../styles.css';
const { evidence, manifest, digests } = loadFixture();
const acts=['Orient','Question','Inspect promotion grain','Inspect fulfillment grain','Inspect returns grain','Inspect data-quality grain','Try the headline','Observe controlled failure','Verify evidence boundaries','Reflect and reset'];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"><title>Promotion trust — Astro candidate</title></head><body><header><p class="notice">TRACKED REAL FIXTURE — UNSCORED — CANNOT COMPLETE</p><h1>Can this promotion headline be trusted?</h1><p>Astro static output with one reversible React control island.</p></header><main><nav aria-label="Lesson acts"><ol>{acts.map((act,index)=><li><a href={`#act-${index+1}`}>{index+1}. {act}</a></li>)}</ol></nav>{acts.map((act,index)=><section id={`act-${index+1}`} data-act={index+1}><h2>Act {index+1}: {act}</h2>{index===1&&<p>Keep each source at its own grain. Similar time windows do not create a join key.</p>}{index===6&&<p class="failure">Controlled failure: promotion performance cannot explain fulfillment, returns, or data quality.</p>}{index===8&&<div class="evidence">{evidence.sources.map(source=><article><h3>{source.sourceId}</h3><p><strong>Grain:</strong> {source.grain.join(', ')}</p><p>{source.records.length} sanitized aggregate records; independent evidence only.</p></article>)}</div>}{index===9&&<><p><strong>Conclusion:</strong> <code>{evidence.decision.value}</code></p><p><strong>Reason:</strong> <code>{evidence.decision.reason}</code></p><Probe client:load /></>}</section>)}</main><footer><p>Manifest {manifest.schemaVersion}; local-artifact-integrity-only.</p><details><summary>Fixture digest facts</summary><pre>{JSON.stringify(digests,null,2)}</pre></details><p class="notice">UNSCORED — NO COMPLETION OR ATTRIBUTION AUTHORITY</p></footer></body></html>
