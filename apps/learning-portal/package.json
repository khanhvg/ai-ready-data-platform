{
  "name": "i5-05-learning-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.22.3",
    "npm": "10.9.8"
  },
  "scripts": {
    "build": "node scripts/verify-stage-a-release.mjs --build",
    "serve": "node scripts/serve-built-portal.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --test --test-concurrency=1 tests/unit/source-binding.test.mjs tests/unit/read-only-router.test.mjs tests/unit/read-only-render.test.mjs tests/unit/read-only-security.test.mjs",
    "test:stage-a": "npm run build && playwright test tests/e2e/stage-a.spec.mjs --config playwright.config.mjs",
    "test:visual": "npm run build && playwright test tests/e2e/visual-review.spec.mjs --config playwright.config.mjs",
    "verify:release": "node scripts/verify-stage-a-release.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@vitejs/plugin-react": "6.0.1",
    "vite": "8.1.5"
  }
}
