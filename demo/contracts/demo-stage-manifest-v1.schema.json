{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ready.local/contracts/demo-stage-manifest/1.0.0",
  "title": "Demo stage manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "demo_content_version",
    "stage_id",
    "status",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "demo_content_version": {"const": "1.0.0"},
    "stage_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["planned", "executed", "historical", "unavailable"]},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/command"}
    },
    "expected_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "cleanup": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/command"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "non_scoring": {"const": true}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}(?:/[A-Za-z0-9_][A-Za-z0-9._-]{0,127})*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "origin": {"enum": ["tracked", "generated", "historical"]},
        "availability": {
          "enum": ["available", "current", "historical", "unavailable"]
        },
        "description": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "purpose",
        "eligible_for_automation",
        "automated",
        "automation_rationale"
      ],
      "properties": {
        "command": {"type": "string", "minLength": 1, "maxLength": 512},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 1024},
        "eligible_for_automation": {"type": "boolean"},
        "automated": {"type": "boolean"},
        "automation_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_sha",
        "evidence_kind",
        "current_execution",
        "references"
      ],
      "properties": {
        "input_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "evidence_kind": {
          "enum": ["current", "historical", "configured", "unavailable"]
        },
        "current_execution": {
          "enum": ["executed", "unexecuted", "not-applicable"]
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relative_path"}
        }
      }
    }
  }
}
