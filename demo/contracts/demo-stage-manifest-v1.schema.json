{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ready.local/contracts/demo-stage-manifest/1.0.0",
  "title": "Demo stage manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "demo_content_version",
    "stage_id",
    "status",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "demo_content_version": {"const": "1.0.0"},
    "stage_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["planned", "executed", "historical", "unavailable"]},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,127})*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
