{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:i5-06:architecture-template-registry-v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "compatibilityRuleVi", "templates"],
