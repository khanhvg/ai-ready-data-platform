{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:i5-06:architecture-trace-v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "traces", "nodes", "edges", "criticalFlows"],
  "properties": {
    "schemaVersion": {"const": "architecture-trace-v1"},
    "traces": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["id", "moduleId", "nodeIds", "forwardPathId", "reversePathId", "criticalFlowId"], "properties": {"id": {"pattern": "^trace-[FJDM][0-9]{2}$"}, "moduleId": {"pattern": "^[FJDM][0-9]{2}$"}, "nodeIds": {"type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": {"type": "string"}}, "forwardPathId": {"type": "string"}, "reversePathId": {"type": "string"}, "criticalFlowId": {"type": ["string", "null"]}}}},
    "nodes": {"type": "object", "additionalProperties": false, "required": ["outcomes", "capabilities", "concerns", "requirements", "options", "views", "decisions", "patterns", "implementations", "evidence", "operations", "consequences"], "properties": {
      "outcomes": {"$ref": "#/$defs/nodeArray"}, "capabilities": {"$ref": "#/$defs/nodeArray"}, "concerns": {"$ref": "#/$defs/nodeArray"}, "requirements": {"$ref": "#/$defs/nodeArray"}, "options": {"$ref": "#/$defs/nodeArray"}, "views": {"$ref": "#/$defs/nodeArray"}, "decisions": {"$ref": "#/$defs/nodeArray"}, "patterns": {"$ref": "#/$defs/nodeArray"}, "implementations": {"$ref": "#/$defs/nodeArray"}, "evidence": {"$ref": "#/$defs/nodeArray"}, "operations": {"$ref": "#/$defs/nodeArray"}, "consequences": {"$ref": "#/$defs/nodeArray"}
    }},
    "edges": {"type": "array", "minItems": 40, "maxItems": 40, "items": {"type": "object", "additionalProperties": false, "required": ["id", "moduleId", "direction", "nodeIds", "reciprocalEdgeId"], "properties": {"id": {"type": "string"}, "moduleId": {"pattern": "^[FJDM][0-9]{2}$"}, "direction": {"enum": ["forward", "reverse"]}, "nodeIds": {"type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": {"type": "string"}}, "reciprocalEdgeId": {"type": "string"}}}},
    "criticalFlows": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["id", "moduleId", "sequenceViewIds", "deploymentViewIds", "orderedSteps"], "properties": {"id": {"type": "string"}, "moduleId": {"pattern": "^[FJDM][0-9]{2}$"}, "sequenceViewIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^DYN-"}}, "deploymentViewIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^DEP-"}}, "orderedSteps": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 2}}}}}
  },
  "$defs": {
    "nodeArray": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/node"}},
    "node": {"type": "object", "additionalProperties": false, "required": ["id", "moduleId", "pathIds", "referenceIds", "contentIds", "consequenceIds", "openApiOperationIds"], "properties": {"id": {"type": "string", "minLength": 3}, "moduleId": {"pattern": "^[FJDM][0-9]{2}$"}, "pathIds": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}}, "referenceIds": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}}, "contentIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "consequenceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "openApiOperationIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}
  }
}
