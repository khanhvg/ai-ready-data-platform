{
  "$id": "urn:i5-06:architecture-trace-v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "traceId", "spine", "criticalFlows", "moduleIds", "templateRegistryId", "viewIds", "adrIds", "verifiers", "operationsConsequences", "moduleTraceBindings"],
  "properties": {
    "schemaVersion": {"const": "i5-06-architecture-trace-v1"},
    "traceId": {"const": "business-evidence-operations-reciprocal-v1"},
    "spine": {"type": "object", "required": ["stages", "reciprocal", "orphanPolicy"]},
    "criticalFlows": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["flowId", "stepIds", "dynamicView", "deploymentView", "bindingClass", "dynamicRelations", "topology"],
        "properties": {
          "flowId": {"pattern": "^CF-[A-Z0-9-]+$"}, "stepIds": {"type": "array", "minItems": 5, "uniqueItems": true},
          "dynamicView": {"type": "string"}, "deploymentView": {"enum": ["DEP-LOCAL", "DEP-AWS"]},
          "bindingClass": {"enum": ["protected-descriptive-only", "local-static-design", "conceptual-only"]},
          "dynamicRelations": {
            "type": "array", "minItems": 5,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["ordinal", "stepId", "sourceId", "targetId", "labelVi", "technology"],
              "properties": {
                "ordinal": {"type": "integer", "minimum": 1}, "stepId": {"type": "string"},
                "sourceId": {"type": "string"}, "targetId": {"type": "string"},
                "labelVi": {"type": "string", "minLength": 3}, "technology": {"type": ["string", "null"]}
              }
            }
          },
          "topology": {
            "type": "object", "additionalProperties": false,
            "required": ["environmentId", "nodes", "endpointPlacements", "edges", "trustBoundaryNodes", "failureNodes"],
            "properties": {
              "environmentId": {"enum": ["local", "aws_conceptual"]},
              "nodes": {"type": "array", "minItems": 5, "uniqueItems": true},
              "endpointPlacements": {"type": "object", "minProperties": 2},
              "edges": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["ordinal", "stepId", "sourceNode", "targetNode"]}},
              "trustBoundaryNodes": {"type": "array", "minItems": 2, "uniqueItems": true},
              "failureNodes": {"type": "array", "minItems": 1, "uniqueItems": true}
            }
          }
        }
      }
    },
    "moduleIds": {"type": "array", "minItems": 20, "maxItems": 20, "uniqueItems": true},
    "templateRegistryId": {"const": "i5-06-architecture-template-registry"},
    "viewIds": {"type": "array", "minItems": 10, "uniqueItems": true},
    "adrIds": {"type": "array", "minItems": 20, "maxItems": 20, "uniqueItems": true},
    "verifiers": {"type": "array", "minItems": 5, "uniqueItems": true},
    "operationsConsequences": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true},
    "moduleTraceBindings": {
      "type": "array", "minItems": 20, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["moduleId", "moduleSha256", "businessOutcomeSha256", "capabilitySha256", "stakeholderConcernSha256", "requirementsSha256", "optionsSha256", "viewIds", "adrId", "patternId", "implementationIntentSha256", "verifier", "consequencesSha256", "reciprocalModuleId"],
        "properties": {
          "moduleId": {"pattern": "^[FJDM][0-9]{2}$"}, "moduleSha256": {"pattern": "^[0-9a-f]{64}$"},
          "businessOutcomeSha256": {"pattern": "^[0-9a-f]{64}$"}, "capabilitySha256": {"pattern": "^[0-9a-f]{64}$"},
          "stakeholderConcernSha256": {"pattern": "^[0-9a-f]{64}$"}, "requirementsSha256": {"pattern": "^[0-9a-f]{64}$"},
          "optionsSha256": {"pattern": "^[0-9a-f]{64}$"}, "viewIds": {"type": "array", "minItems": 1, "uniqueItems": true},
          "adrId": {"pattern": "^ADR-[FJDM][0-9]{2}$"}, "patternId": {"pattern": "^PAT-[A-Z0-9-]+$"},
          "implementationIntentSha256": {"pattern": "^[0-9a-f]{64}$"}, "verifier": {"type": "string"},
          "consequencesSha256": {"pattern": "^[0-9a-f]{64}$"}, "reciprocalModuleId": {"pattern": "^[FJDM][0-9]{2}$"}
        }
      }
    }
  }
}
