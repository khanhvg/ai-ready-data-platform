{"schemaVersion":"i5-06-system-design-patterns-v1","patterns":[
{"patternId":"PAT-BOUNDARY","forces":["ownership","change cadence"],"failure":"shared responsibility hides incidents","qualityBoundary":"one owner per authority","verifier":"trace reciprocity","consequences":["more contracts"],"removalRule":"merge only when ownership and failure domain are identical"},
{"patternId":"PAT-IDEMPOTENCY","forces":["retry","partial state"],"failure":"duplicate commit","qualityBoundary":"same request has one effect","verifier":"resume mutation","consequences":["state lookup"],"removalRule":"remove only when operation cannot repeat"},
{"patternId":"PAT-OPTION-MATRIX","forces":["conflicting qualities"],"failure":"choice by preference","qualityBoundary":"two evidenced alternatives","verifier":"ADR completeness","consequences":["decision upkeep"],"removalRule":"archive after decision and rollback horizon expire"},
{"patternId":"PAT-CONCERN-VIEW","forces":["different audiences"],"failure":"mixed abstraction diagram","qualityBoundary":"one concern per view","verifier":"view admission","consequences":["multiple views"],"removalRule":"delete view with no active decision"},
{"patternId":"PAT-GRAIN-GATE","forces":["heterogeneous facts"],"failure":"false attribution","qualityBoundary":"common grain before join","verifier":"promotion oracle","consequences":["insufficient-evidence outcomes"],"removalRule":"replace after a released compatible grain exists"},
{"patternId":"PAT-CONTRACT-FIRST","forces":["multiple clients"],"failure":"invented endpoint or channel","qualityBoundary":"released operation only","verifier":"operation matrix","consequences":["version governance"],"removalRule":"supersede through registered contract version"},
{"patternId":"PAT-RETRY-JITTER","forces":["transient failure","contention"],"failure":"retry storm","qualityBoundary":"deadline and idempotency","verifier":"ordered retry flow","consequences":["longer tail"],"removalRule":"remove retry when failure is permanent"},
{"patternId":"PAT-BACKPRESSURE","forces":["arrival exceeds service"],"failure":"memory exhaustion","qualityBoundary":"bounded queue","verifier":"capacity gate","consequences":["early rejection"],"removalRule":"remove only when producer is synchronously bounded"},
{"patternId":"PAT-VERSIONED-CACHE","forces":["read latency","freshness"],"failure":"stale result presented current","qualityBoundary":"cache key includes authority version","verifier":"freshness mutation","consequences":["more cache entries"],"removalRule":"disable when latency budget permits authority reads"},
{"patternId":"PAT-SERVICE-EXTRACTION","forces":["independent scaling","failure isolation"],"failure":"distributed complexity without benefit","qualityBoundary":"proved deploy seam","verifier":"extraction criteria","consequences":["network and on-call"],"removalRule":"recombine when independent forces disappear"},
{"patternId":"PAT-DUAL-AUTHORITY","forces":["physical and logical metadata"],"failure":"catalog mistaken for data truth","qualityBoundary":"linked distinct authorities","verifier":"lineage reconciliation","consequences":["reingest path"],"removalRule":"remove link only if one authority is retired"},
{"patternId":"PAT-COMMIT-POINTER","forces":["atomic visibility","immutable objects"],"failure":"partial snapshot becomes current","qualityBoundary":"validate before pointer","verifier":"publish order","consequences":["orphan cleanup"],"removalRule":"replace only with equivalent transactional authority"},
{"patternId":"PAT-GUARDED-WINDOW","forces":["heavy profiles","fresh metadata"],"failure":"unbounded co-run","qualityBoundary":"deadline and close","verifier":"resource controller","consequences":["bounded freshness delay"],"removalRule":"remove when resource isolation is independently proved"},
{"patternId":"PAT-DATA-SLO","forces":["freshness","correctness"],"failure":"green availability hides bad data","qualityBoundary":"separate indicators","verifier":"fitness threshold","consequences":["multiple budgets"],"removalRule":"retire only with stakeholder-approved replacement"},
{"patternId":"PAT-AUTHORITY-RESTORE","forces":["different RPO","dependencies"],"failure":"stale pointer after restore","qualityBoundary":"ordered verified restore","verifier":"restore topology","consequences":["longer drill"],"removalRule":"update when authority inventory changes"},
{"patternId":"PAT-CLOSED-EVIDENCE","forces":["tamper detection","privacy"],"failure":"orphan evidence accepted","qualityBoundary":"closed index","verifier":"index closure","consequences":["strict retention"],"removalRule":"supersede only with compatible closed envelope"},
{"patternId":"PAT-OFFICE-HOURS","forces":["cost","readiness"],"failure":"endpoint exposed before hydrate","qualityBoundary":"readiness gate","verifier":"office flow order","consequences":["startup latency"],"removalRule":"remove when always-on demand is evidenced"},
{"patternId":"PAT-ZERO-IMPLICIT-TRUST","forces":["authority crossing"],"failure":"ambient privilege","qualityBoundary":"explicit principal","verifier":"security review","consequences":["policy operations"],"removalRule":"never remove; replace only with stronger explicit control"},
{"patternId":"PAT-COST-ENVELOPE","forces":["uncertain workload"],"failure":"current price presented as architecture fact","qualityBoundary":"driver ranges only","verifier":"claim scan","consequences":["TBCs remain"],"removalRule":"replace after measured workload and authorized pricing study"},
{"patternId":"PAT-FITNESS-BOUND-ADR","forces":["decision drift"],"failure":"ADR becomes stale prose","qualityBoundary":"decision links verifier","verifier":"mutation suite","consequences":["automation upkeep"],"removalRule":"retire with ADR supersession and rollback proof"}]}
