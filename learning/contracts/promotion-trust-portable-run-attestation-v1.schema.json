{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-ready-data-platform:promotion-trust-portable-run-attestation-v1",
  "type": "object",
  "required": ["schemaVersion", "testedTreeSha", "sourceBundleVerification", "runs", "timing", "equality", "integrityScope", "publisherAuthenticity", "integrity"],
  "properties": {
    "schemaVersion": {"const": "promotion-trust-portable-run-attestation-v1"},
    "testedTreeSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sourceBundleVerification": {"const": "strict-owner-bound-at-publication"},
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["runId", "testedTreeSha", "startedMonotonicNs", "finishedMonotonicNs", "durationMs", "completionSha256", "coreSha256", "projectionSha256", "normalizedRawSha256"],
        "properties": {
          "runId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
          "testedTreeSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "startedMonotonicNs": {"type": "integer", "minimum": 0},
          "finishedMonotonicNs": {"type": "integer", "minimum": 0},
          "durationMs": {"type": "integer", "minimum": 0, "maximum": 300000},
          "completionSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "coreSha256": {
            "type": "object",
            "required": ["raw.json", "projection.json", "envelope.json", "result.json", "run-metadata.json"],
            "properties": {
              "raw.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "projection.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "envelope.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "result.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "run-metadata.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          },
          "projectionSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "normalizedRawSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "timing": {
      "type": "object",
      "required": ["runsSequential", "pairDurationMs", "maxRunDurationMs", "maxPairDurationMs"],
      "properties": {
        "runsSequential": {"const": true},
        "pairDurationMs": {"type": "integer", "minimum": 0, "maximum": 600000},
        "maxRunDurationMs": {"const": 300000},
        "maxPairDurationMs": {"const": 600000}
      },
      "additionalProperties": false
    },
    "equality": {
      "type": "object",
      "required": ["projection", "normalizedRaw"],
      "properties": {"projection": {"const": "exact"}, "normalizedRaw": {"const": "exact"}},
      "additionalProperties": false
    },
    "integrityScope": {"const": "local-artifact-integrity-only"},
    "publisherAuthenticity": {"const": "externally-attested-not-claimed"},
    "integrity": {
      "type": "object",
      "required": ["canonicalization", "algorithm", "payloadSha256"],
      "properties": {
        "canonicalization": {"const": "rfc8785-jcs-v1"},
        "algorithm": {"const": "sha-256"},
        "payloadSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
