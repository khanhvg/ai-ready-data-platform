{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/learning/operation-matrix-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channels",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "operation-matrix-v1"
    },
    "channels": {
      "type": "array",
      "maxItems": 0
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "method",
          "path",
          "successStatus",
          "authorization",
          "idempotency",
          "taxonomy",
          "processRole",
          "evidenceRule"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "method": {
            "enum": [
              "GET",
              "POST"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/(?:[A-Za-z0-9._-]+|\\{[A-Za-z][A-Za-z0-9]*\\})(?:/(?:[A-Za-z0-9._-]+|\\{[A-Za-z][A-Za-z0-9]*\\}))*$"
          },
          "successStatus": {
            "type": "integer",
            "minimum": 0
          },
          "authorization": {
            "enum": [
              "bearer",
              "public"
            ]
          },
          "idempotency": {
            "type": "boolean"
          },
          "taxonomy": {
            "enum": [
              "Experience",
              "Process",
              "System",
              "Backend",
              "Technical"
            ]
          },
          "processRole": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "evidenceRule": {
            "enum": [
              "none",
              "required"
            ]
          }
        }
      }
    }
  }
}
