{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/learning/operation-matrix-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channels",
    "operations"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]{2,63}$"
    },
    "header": {
      "enum": [
        "Authorization",
        "X-Correlation-ID",
        "Host",
        "Origin",
        "X-CSRF-Token",
        "Idempotency-Key",
        "Content-Type"
      ]
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "code"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": "operation-matrix-v1"
    },
    "channels": {
      "type": "array",
      "maxItems": 0
    },
    "operations": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "method",
          "path",
          "apiVersion",
          "taxonomy",
          "processRole",
          "authn",
          "authz",
          "csrf",
          "request",
          "response",
          "problems",
          "idempotency",
          "cas",
          "evidence"
        ],
        "properties": {
          "operationId": {
            "$ref": "#/$defs/id"
          },
          "method": {
            "enum": [
              "GET",
              "POST"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "apiVersion": {
            "const": "v1"
          },
          "taxonomy": {
            "enum": [
              "Experience",
              "Process",
              "System",
              "Backend",
              "Technical"
            ]
          },
          "processRole": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "authn": {
            "enum": [
              "local-session",
              "public-loopback"
            ]
          },
          "authz": {
            "enum": [
              "catalog-read",
              "actor-owned",
              "actor-owned-product-read",
              "public-health"
            ]
          },
          "csrf": {
            "enum": [
              "required",
              "not-applicable"
            ]
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "parameters",
              "headers"
            ],
            "properties": {
              "schema": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Za-z][A-Za-z0-9]+Request$"
              },
              "parameters": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"
                }
              },
              "headers": {
                "type": "array",
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/header"
                }
              }
            }
          },
          "response": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "schema",
              "headers"
            ],
            "properties": {
              "status": {
                "enum": [
                  200,
                  201,
                  202
                ]
              },
              "schema": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]+$"
              },
              "headers": {
                "const": [
                  "X-Correlation-ID",
                  "X-Learning-Contract-Version"
                ]
              }
            }
          },
          "problems": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/problem"
            }
          },
          "idempotency": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "keyHeader",
              "canonicalRequestHash"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "read-only",
                  "required"
                ]
              },
              "keyHeader": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "Idempotency-Key",
                  null
                ]
              },
              "canonicalRequestHash": {
                "type": "boolean"
              }
            }
          },
          "cas": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workspaceRevision",
              "progressRevision"
            ],
            "properties": {
              "workspaceRevision": {
                "type": "boolean"
              },
              "progressRevision": {
                "type": "boolean"
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "completionAuthority"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "none",
                  "required"
                ]
              },
              "completionAuthority": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "learning-progress-authority-v1",
                  null
                ]
              }
            }
          }
        }
      }
    }
  }
}
