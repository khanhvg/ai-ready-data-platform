{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/learning/command-owner-activation-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baseRegistryPath",
    "baseRegistrySha256",
    "owner",
    "fragment",
    "commands"
  ],
  "properties": {
    "schemaVersion": {
      "const": "command-owner-activation-v1"
    },
    "baseRegistryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,256}$"
    },
    "baseRegistrySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,256}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commandId",
          "availability",
          "evidenceVersion"
        ],
        "properties": {
          "commandId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "availability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "evidenceVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
