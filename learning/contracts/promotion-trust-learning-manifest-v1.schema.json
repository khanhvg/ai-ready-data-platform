{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/learning/promotion-trust-learning-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "lesson",
    "lab",
    "evidenceSchema",
    "dataContract",
    "fixture",
    "fixtureSha256",
    "sources",
    "decision",
    "limitations",
    "contractSetSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "promotion-trust-learning-manifest-v1"
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "lesson": { "$ref": "#/$defs/reference" },
    "lab": { "$ref": "#/$defs/reference" },
    "evidenceSchema": { "$ref": "#/$defs/reference" },
    "dataContract": { "$ref": "#/$defs/reference" },
    "fixture": { "$ref": "#/$defs/reference" },
    "fixtureSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grain", "keys", "document"],
        "properties": {
          "grain": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "keys": {
            "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
          },
          "document": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "statement": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "contractSetSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,256}$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
