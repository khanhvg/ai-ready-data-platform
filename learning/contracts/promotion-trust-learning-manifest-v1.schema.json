{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/learning/promotion-trust-learning-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "lesson",
    "lab",
    "evidenceSchema",
    "dataContract",
    "fixture",
    "fixtureSha256",
    "sources",
    "decision",
    "limitations",
    "contractSetSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "promotion-trust-learning-manifest-v1"
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "lesson": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "lab": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "evidenceSchema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "dataContract": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "fixture": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "fixtureSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "contractSetSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
