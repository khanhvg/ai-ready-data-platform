{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/learning/learning-evidence-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "lesson", "lab", "actor", "workspaceId", "runId", "operationId", "inputGitSha", "officialGoldenMainSha", "dependencyMergeShas", "contractHashes", "fixtureHashes", "verifier", "environment", "parameters", "transitions", "commands", "assertions", "artifacts", "timing", "redactionClass", "retentionClass", "rollback", "integrity"],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "versioned": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
    "hashEntry": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["locator", "mediaType", "size", "sha256"], "properties": {"locator": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"}, "mediaType": {"enum": ["application/json", "text/plain"]}, "size": {"type": "integer", "minimum": 0, "maximum": 10485760}, "sha256": {"$ref": "#/$defs/sha256"}}}
  },
  "properties": {
    "schemaVersion": {"const": "learning-evidence-v1"}, "evidenceId": {"$ref": "#/$defs/id"}, "lesson": {"$ref": "#/$defs/versioned"}, "lab": {"$ref": "#/$defs/versioned"},
    "actor": {"type": "object", "additionalProperties": false, "required": ["subjectId", "authContextSha256"], "properties": {"subjectId": {"$ref": "#/$defs/id"}, "authContextSha256": {"$ref": "#/$defs/sha256"}}},
    "workspaceId": {"$ref": "#/$defs/id"}, "runId": {"$ref": "#/$defs/id"}, "operationId": {"$ref": "#/$defs/id"}, "inputGitSha": {"$ref": "#/$defs/gitSha"}, "officialGoldenMainSha": {"$ref": "#/$defs/gitSha"},
    "dependencyMergeShas": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/gitSha"}},
    "contractHashes": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/hashEntry"}}, "fixtureHashes": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/hashEntry"}},
    "verifier": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["python", "platform", "offline"], "properties": {"python": {"type": "string", "pattern": "^3\\.12\\.[0-9]+$"}, "platform": {"enum": ["darwin-arm64", "linux-x86_64"]}, "offline": {"const": true}}},
    "parameters": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "transitions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "revision"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "revision": {"type": "integer", "minimum": 0}}}},
    "commands": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["argv", "rc"], "properties": {"argv": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "rc": {"type": "integer", "minimum": 0, "maximum": 255}}}},
    "assertions": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {"id": {"$ref": "#/$defs/id"}, "status": {"enum": ["pass", "fail"]}}}},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/artifact"}},
    "timing": {"type": "object", "additionalProperties": false, "required": ["startedAt", "finishedAt", "durationMs"], "properties": {"startedAt": {"type": "string", "format": "date-time"}, "finishedAt": {"type": "string", "format": "date-time"}, "durationMs": {"type": "integer", "minimum": 0, "maximum": 120000}}},
    "redactionClass": {"const": "public-contract-evidence"}, "retentionClass": {"const": "review-bundle"},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["supported", "preserveEvidence"], "properties": {"supported": {"const": true}, "preserveEvidence": {"const": true}}},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["algorithm", "payloadSha256"], "properties": {"algorithm": {"const": "sha-256+jcs"}, "payloadSha256": {"$ref": "#/$defs/sha256"}}}
  }
}
