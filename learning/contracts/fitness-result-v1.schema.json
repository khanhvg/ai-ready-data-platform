{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-ready-data-platform:fitness-result-v1",
  "type": "object",
  "required": ["schemaVersion", "commandId", "owner", "requested", "status", "failureCode", "remediation", "testedTreeSha", "toolchain", "lockSha256", "startedAt", "finishedAt", "durationMs", "rawLocator", "projectionLocator", "envelopeLocator", "projectionSha256", "artifacts"],
  "properties": {
    "schemaVersion": {"const": "fitness-result-v1"},
    "commandId": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "owner": {"const": "I5-01"},
    "requested": {"type": "object"},
    "status": {"enum": ["pass", "fail"]},
    "failureCode": {"type": ["string", "null"]},
    "remediation": {"type": ["string", "null"]},
    "testedTreeSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "toolchain": {"type": "object"},
    "lockSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "startedAt": {"type": "string"},
    "finishedAt": {"type": "string"},
    "durationMs": {"type": "integer", "minimum": 0},
    "rawLocator": {"type": ["string", "null"]},
    "projectionLocator": {"type": ["string", "null"]},
    "envelopeLocator": {"type": ["string", "null"]},
    "projectionSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {"type": "array"}
  },
  "additionalProperties": false
}
