{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-ready-data-platform:golden-evidence-envelope-v1",
  "type": "object",
  "required": ["schemaVersion", "payload", "integrity"],
  "properties": {
    "schemaVersion": {"const": "golden-evidence-envelope-v1"},
    "payload": {"type": "object"},
    "integrity": {
      "type": "object",
      "required": ["canonicalization", "algorithm", "payloadSha256"],
      "properties": {
        "canonicalization": {"const": "rfc8785-jcs-v1"},
        "algorithm": {"const": "sha-256"},
        "payloadSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
