{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/learning/lesson-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "summary", "level", "competencies", "outcome", "stakeholder", "prerequisites", "prerequisiteChecks", "fr", "nfr", "asr", "architectureViews", "decision", "patterns", "narrativeSteps", "lab", "evidence", "reflection", "accessibility", "remediation", "hints"],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512},
    "identifierList": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
  },
  "properties": {
    "schemaVersion": {"const": "lesson-v1"},
    "id": {"$ref": "#/$defs/identifier"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"$ref": "#/$defs/text"},
    "summary": {"$ref": "#/$defs/text"},
    "level": {"enum": ["beginner", "mid", "advanced"]},
    "competencies": {"$ref": "#/$defs/identifierList"},
    "outcome": {"$ref": "#/$defs/text"},
    "stakeholder": {"$ref": "#/$defs/text"},
    "prerequisites": {"$ref": "#/$defs/identifierList"},
    "prerequisiteChecks": {"$ref": "#/$defs/identifierList"},
    "fr": {"$ref": "#/$defs/identifierList"},
    "nfr": {"$ref": "#/$defs/identifierList"},
    "asr": {"$ref": "#/$defs/identifierList"},
    "architectureViews": {"$ref": "#/$defs/identifierList"},
    "decision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9/-]{0,127}$"},
    "patterns": {"$ref": "#/$defs/identifierList"},
    "narrativeSteps": {"$ref": "#/$defs/identifierList"},
    "lab": {"$ref": "#/$defs/identifier"},
    "evidence": {"$ref": "#/$defs/identifierList"},
    "reflection": {"$ref": "#/$defs/text"},
    "accessibility": {"$ref": "#/$defs/identifier"},
    "remediation": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}},
    "hints": {"$ref": "#/$defs/identifierList"}
  }
}
