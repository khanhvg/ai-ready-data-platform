{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/learning/lesson-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "summary",
    "level",
    "competencies",
    "outcome",
    "stakeholder",
    "prerequisites",
    "prerequisiteChecks",
    "fr",
    "nfr",
    "asr",
    "architectureViews",
    "decision",
    "patterns",
    "narrativeSteps",
    "lab",
    "evidence",
    "reflection",
    "accessibility",
    "remediation",
    "hints"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "competency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "measure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "measure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertionId",
        "required"
      ],
      "properties": {
        "assertionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "revealAfter",
        "evidenceEvent",
        "completes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "revealAfter": {
          "type": "integer",
          "minimum": 0
        },
        "evidenceEvent": {
          "const": "guidance-viewed"
        },
        "completes": {
          "const": false
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": "lesson-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "level": {
      "enum": [
        "foundation",
        "junior",
        "mid",
        "advanced"
      ]
    },
    "competencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/competency"
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "evidenceIds"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        }
      }
    },
    "stakeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "concern",
        "decision"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "concern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "kind": {
            "enum": [
              "competency",
              "environment",
              "tool"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "prerequisiteChecks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probeId",
          "kind",
          "class",
          "expected",
          "remediation",
          "retry"
        ],
        "properties": {
          "probeId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "kind": {
            "enum": [
              "contract",
              "fixture",
              "tool",
              "state"
            ]
          },
          "class": {
            "enum": [
              "required",
              "optional"
            ]
          },
          "expected": {
            "enum": [
              "pass",
              "fail",
              "unavailable"
            ]
          },
          "remediation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "retry": {
            "const": "read-only"
          }
        }
      }
    },
    "fr": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "nfr": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "asr": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "architectureViews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "alternatives",
        "selected",
        "status"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "alternatives": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        },
        "selected": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "status": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "addressedRisk"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "addressedRisk": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        }
      }
    },
    "narrativeSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "reversible",
          "staticEquivalent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "reversible": {
            "const": true
          },
          "staticEquivalent": {
            "const": true
          }
        }
      }
    },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "reflection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "completes"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "completes": {
          "const": false
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyboard",
        "announcements",
        "staticEquivalent",
        "reducedMotion"
      ],
      "properties": {
        "keyboard": {
          "const": true
        },
        "announcements": {
          "const": true
        },
        "staticEquivalent": {
          "const": true
        },
        "reducedMotion": {
          "const": true
        }
      }
    },
    "remediation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "action",
          "revealPolicy"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "revealPolicy": {
            "enum": [
              "immediate",
              "after-ordered-hints"
            ]
          }
        }
      }
    },
    "hints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hint"
      }
    }
  }
}
