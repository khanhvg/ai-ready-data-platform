{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/learning/fitness-result-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "owner", "requested", "status", "failureCode", "remediation", "inputSha", "testedTreeSha", "dependencyMergeShas", "contractHashes", "fixtureHashes", "schemaHashes", "toolchain", "lockSha256", "invocation", "startedAt", "finishedAt", "durationMs", "rawLocator", "projectionLocator", "envelopeLocator", "projectionSha256", "artifacts", "redactionClass", "retentionClass", "rollback", "canonicalization", "payloadSha256"],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locator": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"},
    "namedHash": {"type": "object", "additionalProperties": false, "required": ["name", "sha256"], "properties": {"name": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["locator", "mediaType", "size", "sha256"], "properties": {"locator": {"$ref": "#/$defs/locator"}, "mediaType": {"enum": ["application/json", "text/plain"]}, "size": {"type": "integer", "minimum": 0, "maximum": 10485760}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "parameter": {"type": "object", "additionalProperties": false, "required": ["name", "valueType", "value"], "properties": {"name": {"$ref": "#/$defs/id"}, "valueType": {"enum": ["boolean", "integer", "string"]}, "value": {"type": ["boolean", "integer", "string"], "maxLength": 256}}}
  },
  "properties": {
    "schemaVersion": {"const": "fitness-result-v2"}, "commandId": {"$ref": "#/$defs/id"}, "owner": {"type": "string", "pattern": "^I[0-9]+-[0-9]+$"},
    "requested": {"type": "object", "additionalProperties": false, "required": ["subjectType", "subjectId", "parameters"], "properties": {"subjectType": {"enum": ["contract-set", "lesson", "evidence"]}, "subjectId": {"$ref": "#/$defs/id"}, "parameters": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/parameter"}}}},
    "status": {"enum": ["pass", "fail"]}, "failureCode": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "remediation": {"type": ["string", "null"], "maxLength": 512}, "inputSha": {"$ref": "#/$defs/gitSha"}, "testedTreeSha": {"$ref": "#/$defs/gitSha"},
    "dependencyMergeShas": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/gitSha"}}, "contractHashes": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/namedHash"}}, "fixtureHashes": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/namedHash"}}, "schemaHashes": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/namedHash"}},
    "toolchain": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1, "maxLength": 64}}}}, "lockSha256": {"$ref": "#/$defs/sha256"},
    "invocation": {"type": "object", "additionalProperties": false, "required": ["publicArgv", "canonicalChildArgv", "actualChildArgvSha256", "cwdRole"], "properties": {"publicArgv": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "canonicalChildArgv": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "actualChildArgvSha256": {"$ref": "#/$defs/sha256"}, "cwdRole": {"const": "repository-root"}}},
    "startedAt": {"type": "string", "format": "date-time"}, "finishedAt": {"type": "string", "format": "date-time"}, "durationMs": {"type": "integer", "minimum": 0, "maximum": 120000}, "rawLocator": {"$ref": "#/$defs/locator"}, "projectionLocator": {"$ref": "#/$defs/locator"}, "envelopeLocator": {"$ref": "#/$defs/locator"}, "projectionSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/artifact"}}, "redactionClass": {"const": "public-contract-evidence"}, "retentionClass": {"const": "review-bundle"}, "rollback": {"type": "object", "additionalProperties": false, "required": ["supported", "preserveEvidence"], "properties": {"supported": {"const": true}, "preserveEvidence": {"const": true}}}, "canonicalization": {"const": "RFC8785"}, "payloadSha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "pass"}}}, "then": {"properties": {"failureCode": {"type": "null"}, "remediation": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "fail"}}}, "then": {"properties": {"failureCode": {"type": "string"}, "remediation": {"type": "string"}}}}
  ]
}
