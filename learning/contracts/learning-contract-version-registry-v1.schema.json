{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/learning/learning-contract-version-registry-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baseRegistry",
    "ownedFamilies",
    "familyExtensions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "learning-contract-version-registry-v1"
    },
    "baseRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,256}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ownedFamilies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "currentVersion",
          "readableVersions",
          "readerId",
          "schema",
          "migrations"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "currentVersion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,63}$"
          },
          "readableVersions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "readerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,256}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "migrations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to",
                "kind"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            }
          }
        }
      }
    },
    "familyExtensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "baseReaderId",
          "addedReadableVersions",
          "migrations",
          "baseCurrentVersion",
          "emissionFallback"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "baseReaderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "addedReadableVersions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "schema",
                "readerId"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,63}$"
                },
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,256}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                },
                "readerId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            }
          },
          "migrations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to",
                "kind"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            }
          },
          "baseCurrentVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "emissionFallback": {
            "type": "null"
          }
        }
      }
    }
  }
}
