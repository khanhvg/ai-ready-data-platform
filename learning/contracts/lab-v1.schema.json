{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/learning/lab-v1.schema.json",
  "title": "lab-v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "lessonId",
    "risk",
    "profile",
    "inputs",
    "workspace",
    "commands",
    "starter",
    "controlledFailure",
    "stateMachine",
    "reset",
    "verify",
    "solution",
    "evidence",
    "accessibility",
    "remediation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "lessonId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "risk": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "starter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "controlledFailure": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "stateMachine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "reset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "verify": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "solution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "accessibility": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "remediation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    }
  },
  "unevaluatedProperties": false
}
