{
  "schemaVersion": "lab-v1",
  "id": "data-platform-weighted-metrics-v1",
  "version": "1.0.0",
  "lessonId": "data-platform-weighted-metrics",
  "risk": {
    "class": "bounded-local",
    "network": "denied",
    "privilege": "unprivileged"
  },
  "profile": {
    "id": "small",
    "seed": 42
  },
  "inputs": [
    {
      "id": "profile",
      "type": "enum",
      "allowed": ["small"],
      "default": "small"
    },
    {
      "id": "seed",
      "type": "integer",
      "minimum": 42,
      "maximum": 42,
      "default": 42
    }
  ],
  "workspace": {
    "template": "data-platform-stage-a-candidate",
    "allowedPaths": ["workspace/metric-table", "workspace/evidence"],
    "quotaBytes": 67108864,
    "cleanup": "atomic-marker-nonce-inode",
    "retention": "ephemeral"
  },
  "commands": [
    {
      "id": "candidate.inspect-metric-rows",
      "arguments": [],
      "timeoutSeconds": 30,
      "memoryBytes": 134217728,
      "network": "denied"
    },
    {
      "id": "candidate.compare-formulas",
      "arguments": [],
      "timeoutSeconds": 30,
      "memoryBytes": 134217728,
      "network": "denied"
    },
    {
      "id": "candidate.reset-workspace",
      "arguments": [],
      "timeoutSeconds": 30,
      "memoryBytes": 134217728,
      "network": "denied"
    }
  ],
  "starter": {
    "source": "issue-6-fulfillment-reader",
    "expectedState": "candidate-ready"
  },
  "controlledFailure": {
    "trigger": "average-of-averages",
    "symptom": "Trung bình các trung bình nhóm làm sai lead time toàn cục.",
    "expectedEvidence": ["AVERAGE_OF_AVERAGES_INVALID"],
    "boundary": "workspace-only"
  },
  "stateMachine": {
    "authority": "learning-progress-authority-v1",
    "initial": "not-started",
    "transitions": [
      {"from": "not-started", "to": "preparing"},
      {"from": "preparing", "to": "ready"},
      {"from": "ready", "to": "running"},
      {"from": "running", "to": "verified"},
      {"from": "verified", "to": "evidenced"},
      {"from": "evidenced", "to": "completed"}
    ],
    "lock": "one-mutation-per-workspace",
    "crashRecovery": "last-committed-transition"
  },
  "reset": {
    "scope": "workspace",
    "atomic": true,
    "preserveProgress": true,
    "preserveEvidence": true,
    "postResetState": "ready"
  },
  "verify": {
    "verifierId": "stage-a.weighted-metrics",
    "assertions": [
      {
        "id": "DL-MET-001",
        "severity": "critical",
        "failureCode": "AVERAGE_OF_AVERAGES_INVALID"
      },
      {
        "id": "DL-MET-002",
        "severity": "critical",
        "failureCode": "METRIC_SEMANTIC_DRIFT"
      }
    ],
    "deterministicInputs": true
  },
  "solution": {
    "version": "1.0.0",
    "revealAfterHints": 3,
    "separateFromStarter": true
  },
  "evidence": {
    "schemaVersion": "learning-evidence-v1",
    "requiredMetadata": ["operationId", "contractHashes", "fixtureHashes", "expectedActual"],
    "retentionClass": "review-bundle"
  },
  "accessibility": {
    "announcedStatus": true,
    "nonColorCues": true,
    "keyboard": true,
    "staticEquivalent": true
  },
  "remediation": [
    {
      "failureCode": "AVERAGE_OF_AVERAGES_INVALID",
      "likelyCause": "Các nhóm có mẫu số khác nhau nhưng được cho trọng số bằng nhau.",
      "action": "Dùng shipment_count trừ in_transit_count làm trọng số lead time."
    },
    {
      "failureCode": "METRIC_SEMANTIC_DRIFT",
      "likelyCause": "Grain, nguồn hoặc measure cố ý không trọng số đã bị đổi.",
      "action": "Khôi phục đúng Rill contract; chỉ áp dụng trọng số cho metric yêu cầu."
    }
  ]
}
