{
  "schemaVersion": "lab-v1",
  "id": "data-platform-deterministic-ingest-v1",
  "version": "1.0.0",
  "lessonId": "data-platform-deterministic-ingest",
  "risk": {
    "class": "bounded-local",
    "network": "denied",
    "privilege": "unprivileged"
  },
  "profile": {
    "id": "small",
    "seed": 42
  },
  "inputs": [
    {
      "id": "profile",
      "type": "enum",
      "allowed": ["small"],
      "default": "small"
    },
    {
      "id": "seed",
      "type": "integer",
      "minimum": 42,
      "maximum": 42,
      "default": 42
    }
  ],
  "workspace": {
    "template": "data-platform-stage-a-candidate",
    "allowedPaths": ["workspace/input-copy", "workspace/evidence"],
    "quotaBytes": 67108864,
    "cleanup": "atomic-marker-nonce-inode",
    "retention": "ephemeral"
  },
  "commands": [
    {
      "id": "candidate.inspect-input",
      "arguments": [],
      "timeoutSeconds": 30,
      "memoryBytes": 134217728,
      "network": "denied"
    },
    {
      "id": "candidate.compare-projection",
      "arguments": [],
      "timeoutSeconds": 30,
      "memoryBytes": 134217728,
      "network": "denied"
    },
    {
      "id": "candidate.reset-workspace",
      "arguments": [],
      "timeoutSeconds": 30,
      "memoryBytes": 134217728,
      "network": "denied"
    }
  ],
  "starter": {
    "source": "issue-6-golden-reader",
    "expectedState": "candidate-ready"
  },
  "controlledFailure": {
    "trigger": "private-input-projection-drift",
    "symptom": "Bản sao riêng giữ tổng dòng nhưng sai checksum hoặc grain.",
    "expectedEvidence": ["GOLDEN_INPUT_MISMATCH"],
    "boundary": "workspace-only"
  },
  "stateMachine": {
    "authority": "learning-progress-authority-v1",
    "initial": "not-started",
    "transitions": [
      {"from": "not-started", "to": "preparing"},
      {"from": "preparing", "to": "ready"},
      {"from": "ready", "to": "running"},
      {"from": "running", "to": "verified"},
      {"from": "verified", "to": "evidenced"},
      {"from": "evidenced", "to": "completed"}
    ],
    "lock": "one-mutation-per-workspace",
    "crashRecovery": "last-committed-transition"
  },
  "reset": {
    "scope": "workspace",
    "atomic": true,
    "preserveProgress": true,
    "preserveEvidence": true,
    "postResetState": "ready"
  },
  "verify": {
    "verifierId": "stage-a.deterministic-ingest",
    "assertions": [
      {
        "id": "DL-ING-001",
        "severity": "critical",
        "failureCode": "GOLDEN_INPUT_MISMATCH"
      },
      {
        "id": "DL-PROT-001",
        "severity": "critical",
        "failureCode": "PROTECTED_GOLDEN_DRIFT"
      }
    ],
    "deterministicInputs": true
  },
  "solution": {
    "version": "1.0.0",
    "revealAfterHints": 3,
    "separateFromStarter": true
  },
  "evidence": {
    "schemaVersion": "learning-evidence-v1",
    "requiredMetadata": ["operationId", "contractHashes", "fixtureHashes", "expectedActual"],
    "retentionClass": "review-bundle"
  },
  "accessibility": {
    "announcedStatus": true,
    "nonColorCues": true,
    "keyboard": true,
    "staticEquivalent": true
  },
  "remediation": [
    {
      "failureCode": "GOLDEN_INPUT_MISMATCH",
      "likelyCause": "Bản sao đầu vào khác projection small/42 đã phát hành.",
      "action": "Tạo lại bản sao riêng từ nguồn vàng và so từng row count, checksum."
    },
    {
      "failureCode": "PROTECTED_GOLDEN_DRIFT",
      "likelyCause": "Một tệp vàng đã bị sửa thay vì bản sao workspace.",
      "action": "Dừng lab, giữ evidence và khôi phục từ commit phát hành."
    }
  ]
}
