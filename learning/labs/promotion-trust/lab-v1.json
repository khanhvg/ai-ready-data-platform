{
  "schemaVersion": "lab-v1",
  "id": "promotion-trust-v1",
  "version": "1.0.0",
  "lessonId": "promotion-trust",
  "risk": {
    "class": "bounded-local",
    "network": "denied",
    "privilege": "unprivileged"
  },
  "profile": {
    "id": "small-42",
    "seed": 42
  },
  "inputs": [
    {
      "id": "profile",
      "type": "enum",
      "allowed": [
        "small"
      ],
      "default": "small"
    },
    {
      "id": "seed",
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "default": 42
    }
  ],
  "workspace": {
    "template": "project-owned",
    "allowedPaths": [
      "workspace"
    ],
    "quotaBytes": 268435456,
    "cleanup": "atomic-marker-nonce-inode",
    "retention": "ephemeral"
  },
  "commands": [
    {
      "id": "workspace.prepare",
      "arguments": [],
      "timeoutSeconds": 120,
      "memoryBytes": 536870912,
      "network": "denied"
    },
    {
      "id": "retail.generate",
      "arguments": [],
      "timeoutSeconds": 120,
      "memoryBytes": 536870912,
      "network": "denied"
    },
    {
      "id": "retail.load",
      "arguments": [],
      "timeoutSeconds": 120,
      "memoryBytes": 536870912,
      "network": "denied"
    },
    {
      "id": "retail.dbt-build",
      "arguments": [],
      "timeoutSeconds": 120,
      "memoryBytes": 536870912,
      "network": "denied"
    },
    {
      "id": "retail.export",
      "arguments": [],
      "timeoutSeconds": 120,
      "memoryBytes": 536870912,
      "network": "denied"
    },
    {
      "id": "promotion.configure",
      "arguments": [],
      "timeoutSeconds": 120,
      "memoryBytes": 536870912,
      "network": "denied"
    },
    {
      "id": "promotion.verify",
      "arguments": [],
      "timeoutSeconds": 120,
      "memoryBytes": 536870912,
      "network": "denied"
    },
    {
      "id": "workspace.reset",
      "arguments": [],
      "timeoutSeconds": 120,
      "memoryBytes": 536870912,
      "network": "denied"
    }
  ],
  "starter": {
    "source": "project-owned",
    "expectedState": "ready"
  },
  "controlledFailure": {
    "trigger": "headline-revenue-overweighted",
    "symptom": "Required operational and quality assertions fail.",
    "expectedEvidence": [
      "METRIC_REFUND_NOT_ACCOUNTED"
    ],
    "boundary": "workspace-only"
  },
  "stateMachine": {
    "authority": "learning-progress-authority-v1",
    "initial": "not-started",
    "transitions": [
      {
        "from": "not-started",
        "to": "preparing"
      },
      {
        "from": "preparing",
        "to": "ready"
      },
      {
        "from": "ready",
        "to": "running"
      },
      {
        "from": "running",
        "to": "verified"
      },
      {
        "from": "verified",
        "to": "evidenced"
      },
      {
        "from": "evidenced",
        "to": "completed"
      }
    ],
    "lock": "one-mutation-per-workspace",
    "crashRecovery": "last-committed-transition"
  },
  "reset": {
    "scope": "workspace",
    "atomic": true,
    "preserveProgress": true,
    "preserveEvidence": true,
    "postResetState": "ready"
  },
  "verify": {
    "verifierId": "promotion.verify",
    "assertions": [
      {
        "id": "four-independent-grains",
        "severity": "critical",
        "failureCode": "PROMOTION_COMMON_GRAIN_FORBIDDEN"
      }
    ],
    "deterministicInputs": true
  },
  "solution": {
    "version": "1.0.0",
    "revealAfterHints": 3,
    "separateFromStarter": true
  },
  "evidence": {
    "schemaVersion": "learning-evidence-v1",
    "requiredMetadata": [
      "operationId",
      "contractHashes",
      "fixtureHashes"
    ],
    "retentionClass": "review-bundle"
  },
  "accessibility": {
    "announcedStatus": true,
    "nonColorCues": true,
    "keyboard": true,
    "staticEquivalent": true
  },
  "remediation": [
    {
      "failureCode": "METRIC_REFUND_NOT_ACCOUNTED",
      "likelyCause": "Refunds omitted.",
      "action": "Inspect the returns grain."
    },
    {
      "failureCode": "DQ_DUPLICATE_ORDER",
      "likelyCause": "Controlled duplicate.",
      "action": "Inspect the data-quality grain."
    }
  ]
}
